<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.timeapp</groupId>
    <artifactId>TimeManagementApp</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>TimeFlow — Time Management App</name>
    <description>JavaFX mobile-style time management dashboard with timetable module</description>

    <properties>
        <java.version>17</java.version>
        <javafx.version>21.0.2</javafx.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        Maven Standard Directory Layout
        ─────────────────────────────────────────────────────────────────────
        Java source  → src/main/java/
        Resources    → src/main/resources/   (css/, fonts/ live here)

        No <sourceDirectory> or <resources> overrides needed.
        Maven resolves both automatically from the standard layout.
    -->

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
    </dependencies>

    <build>

        <!--
            pluginManagement: registers the "javafx" prefix so that
            `mvn javafx:run` works without editing ~/.m2/settings.xml.
            Without this, Maven cannot resolve the org.openjfx group
            prefix from its default plugin groups.
        -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-maven-plugin</artifactId>
                    <version>0.0.8</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>

            <!-- Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <!--
                JavaFX Maven Plugin
                Run with:  mvn javafx:run

                mainClass format: <moduleName>/<fullyQualifiedMainClass>
                Required by JPMS (module-info.java is present).
            -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <executions>
                    <execution>
                        <id>default-cli</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.timeapp/com.timeapp.MainApp</mainClass>
                            <launcher>timeflow</launcher>
                            <jlinkZipName>timeflow</jlinkZipName>
                            <jlinkImageName>timeflow</jlinkImageName>
                            <noManPages>true</noManPages>
                            <stripDebug>true</stripDebug>
                            <noHeaderFiles>true</noHeaderFiles>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                exec-maven-plugin fallback
                If `mvn javafx:run` still fails (older Maven, offline),
                use:  mvn compile exec:java
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>com.timeapp.MainApp</mainClass>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
